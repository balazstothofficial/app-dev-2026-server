<?xml version="1.0" encoding="utf-8"?>
<!--
The manifest defines core information about the Android app. The INTERNET permission is
required so the app can communicate with the Ktor server. Without this permission, the app
cannot send HTTP requests.

The application tag also references a network security configuration file. This file allows
additional control over how the app handles network connections, for example allowing cleartext
traffic during development or defining trusted certificates.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for making HTTP requests to the server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+ also asks the user before connecting to the local lecture server. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/name_app"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComposeUI"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Links to the network security config file used during development -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ComposeUI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
